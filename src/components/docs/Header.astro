---
/**
 * Starlight Header override.
 * Reuses the main website's Header component, styled to match the website root,
 * with Starlight's search box and mobile navigation support.
 */
import type { Props } from '@astrojs/starlight/props';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteHeader from '../Header.astro';
---

<div class="ha-docs-header">
  <SiteHeader>
    <div slot="search" class="header-search">
      <Search {...Astro.props} />
    </div>
  </SiteHeader>
</div>

<style is:global>
  :root {
    --sl-nav-height: 102px;
  }
  header.header {
    padding: 0 !important;
    border-bottom: none !important;
  }
  /* Visually hide Starlight's default circular menu button; header hamburger controls it */
  starlight-menu-button {
    position: absolute !important;
    opacity: 0 !important;
    pointer-events: none !important;
    width: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
  }
</style>

<style>
  /* -----------------------------------------------------------------------
   * Replicate the HTTP Archive main site header styles for docs
   * Exactly matching src/styles/styles.css and bootstrap.min.css
   * --------------------------------------------------------------------- */

  .ha-docs-header {
    font-family: "Open Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 13px;
    line-height: 25px;
    color: #667a7d;
    width: 100%;
  }

  .ha-docs-header :global(header) {
    border-top: 5px solid #eee;
    padding: 20px 15px;
    background-color: #fff;
    font-family: "Open Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 13px;
    line-height: 25px;
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .ha-docs-header :global(.container) {
    padding: 0 18px;
    margin-right: auto;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    max-width: 1200px;
  }

  .ha-docs-header :global([class*="col"]) {
    padding: 0;
    width: auto;
    float: none;
  }

  .ha-docs-header :global(.col-lg-10) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .ha-docs-header :global(.logo) {
    max-height: 57px;
    width: auto;
    display: block;
  }

  .ha-docs-header :global(nav#desktop) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: #667a7d;
  }

  .ha-docs-header :global(nav#desktop > ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
  }

  .ha-docs-header :global(nav#desktop li) {
    position: relative;
    display: inline-block;
    text-transform: uppercase;
    white-space: nowrap;
    margin: 0;
    padding: 0;
    font-size: 13px;
    line-height: 25px;
    font-weight: 400;
  }

  .ha-docs-header :global(nav#desktop li:not(:last-child)) {
    margin-right: 8px;
  }

  .ha-docs-header :global(nav#desktop li a),
  .ha-docs-header :global(nav#desktop li .dropdown-target) {
    display: inline-block;
    padding: 12px 20px;
    color: #667a7d;
    text-decoration: none;
    cursor: pointer;
    font-size: 13px;
    line-height: 25px;
    font-weight: 400;
  }

  .ha-docs-header :global(.dropdown-target svg) {
    display: inline-block;
    vertical-align: sub;
    fill: currentColor;
  }

  .ha-docs-header :global(nav#desktop li:hover),
  .ha-docs-header :global(nav#desktop li:focus-within) {
    text-decoration: none;
    background-color: #667a7d;
    color: #fff;
  }

  .ha-docs-header :global(nav#desktop li:hover > a),
  .ha-docs-header :global(nav#desktop li:hover > .dropdown-target),
  .ha-docs-header :global(nav#desktop li:focus-within > a),
  .ha-docs-header :global(nav#desktop li:focus-within > .dropdown-target) {
    color: #fff;
  }

  /* Dropdowns */
  .ha-docs-header :global(nav#desktop ul.dropdown-content) {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background-color: #667a7d;
    text-align: left;
    z-index: 1000;
    min-width: 160px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ha-docs-header :global(nav#desktop li:hover > ul.dropdown-content),
  .ha-docs-header :global(nav#desktop li:focus-within > ul.dropdown-content) {
    display: block;
  }

  .ha-docs-header :global(nav#desktop ul.dropdown-content li) {
    display: block;
    margin: 0;
  }

  .ha-docs-header :global(nav#desktop ul.dropdown-content li:not(:last-child)) {
    margin: 0;
  }

  .ha-docs-header :global(nav#desktop ul.dropdown-content li a) {
    display: block;
    padding: 12px 20px;
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    line-height: 25px;
    font-weight: 400;
  }

  .ha-docs-header :global(nav#desktop ul.dropdown-content li a:hover) {
    text-decoration: underline;
  }

  /* Search box */
  .ha-docs-header .header-search {
    display: flex;
    align-items: center;
  }

  .ha-docs-header :global(site-search button[data-open-modal]) {
    color: #667a7d;
  }

  .ha-docs-header :global(site-search button[data-open-modal]:hover) {
    color: #444;
  }

  /* Hamburger button (mobile only) */
  .ha-docs-header :global(.hamburger) {
    display: none;
    border: none;
    background: none;
    color: #999;
    padding: 4px;
    line-height: 1;
    cursor: pointer;
    vertical-align: middle;
  }

  .ha-docs-header :global(.hamburger svg) {
    fill: currentColor;
    display: block;
    width: 28px;
    height: 28px;
  }

  .ha-docs-header :global(.hamburger:hover),
  .ha-docs-header :global(.hamburger:focus) {
    color: #444;
    outline: none;
  }

  /* Responsive breakpoints */
  @media (max-width: 767px) {
    .ha-docs-header :global(nav#desktop) {
      display: none !important;
    }

    .ha-docs-header :global(.hamburger) {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
    }
  }

  /* Mobile nav dropdown (splash page) */
  .ha-docs-header :global(nav#mobile) {
    display: none;
    background-color: #667a7d;
    width: 100%;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 1000;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    max-height: calc(100vh - var(--sl-nav-height, 102px));
    overflow-y: auto;
  }

  .ha-docs-header :global(nav#mobile.active) {
    display: block !important;
  }

  .ha-docs-header :global(nav#mobile ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ha-docs-header :global(nav#mobile li) {
    display: block;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    margin: 0;
    background-color: #667a7d;
    color: #fff;
  }

  .ha-docs-header :global(nav#mobile li a) {
    display: block;
    padding: 14px 20px;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 13px;
    font-weight: 600;
  }

  .ha-docs-header :global(nav#mobile li a:hover),
  .ha-docs-header :global(nav#mobile li a:focus) {
    text-decoration: underline;
  }

  .ha-docs-header :global(nav#mobile li .dropdown-target) {
    display: block;
    padding: 14px 20px;
    color: #fff;
    text-transform: uppercase;
    font-size: 13px;
    font-weight: 600;
  }

  .ha-docs-header :global(nav#mobile li .dropdown-target svg) {
    display: inline-block;
    vertical-align: middle;
    margin-left: 6px;
    fill: currentColor;
  }

  .ha-docs-header :global(nav#mobile li ul.dropdown-content) {
    display: block;
    position: static;
    background-color: rgba(0, 0, 0, 0.12);
  }

  .ha-docs-header :global(nav#mobile li ul.dropdown-content a) {
    padding: 10px 20px 10px 36px;
    font-size: 12px;
    font-weight: 400;
  }
</style>

<script>
  function setupDocsMobileMenu() {
    const hamburger = document.querySelector('.ha-docs-header .hamburger');
    const mobileNav = document.querySelector('.ha-docs-header nav#mobile');
    const desktopNav = document.querySelector('.ha-docs-header nav#desktop');

    // Populate mobile nav with desktop links if empty
    if (mobileNav && desktopNav && !mobileNav.hasChildNodes()) {
      const desktopUl = desktopNav.querySelector('ul');
      if (desktopUl) {
        mobileNav.appendChild(desktopUl.cloneNode(true));
      }
    }

    if (hamburger && !hamburger.hasAttribute('data-initialized')) {
      hamburger.setAttribute('data-initialized', 'true');
      hamburger.addEventListener('click', () => {
        const starlightBtn = document.querySelector('starlight-menu-button button') as HTMLButtonElement | null;
        if (starlightBtn) {
          // On pages with Starlight sidebar drawer, delegate toggle to Starlight
          starlightBtn.click();
          const expanded = starlightBtn.getAttribute('aria-expanded');
          hamburger.setAttribute('aria-expanded', expanded || 'false');
        } else if (mobileNav) {
          // On splash pages without sidebar drawer, toggle nav#mobile
          const isExpanded = mobileNav.classList.toggle('active');
          hamburger.setAttribute('aria-expanded', String(isExpanded));
        }
      });
    }
  }

  // Close mobile nav when clicking outside
  document.addEventListener('click', (e) => {
    const mobileNav = document.querySelector('.ha-docs-header nav#mobile');
    const hamburger = document.querySelector('.ha-docs-header .hamburger');
    if (!mobileNav || !mobileNav.classList.contains('active')) return;
    const target = e.target as HTMLElement | null;
    if (target && !mobileNav.contains(target) && !hamburger?.contains(target)) {
      mobileNav.classList.remove('active');
      hamburger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Close mobile nav on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const mobileNav = document.querySelector('.ha-docs-header nav#mobile');
      const hamburger = document.querySelector('.ha-docs-header .hamburger');
      if (mobileNav?.classList.contains('active')) {
        mobileNav.classList.remove('active');
        hamburger?.setAttribute('aria-expanded', 'false');
      }
    }
  });

  // Keep hamburger aria-expanded synchronized if Starlight's menu changes
  const observer = new MutationObserver(() => {
    const isExpanded = document.body.hasAttribute('data-mobile-menu-expanded');
    const hamburger = document.querySelector('.ha-docs-header .hamburger');
    const starlightBtn = document.querySelector('starlight-menu-button button');
    if (hamburger && starlightBtn) {
      hamburger.setAttribute('aria-expanded', String(isExpanded));
    }
  });
  observer.observe(document.body, { attributes: true, attributeFilter: ['data-mobile-menu-expanded'] });

  setupDocsMobileMenu();
  document.addEventListener('astro:page-load', setupDocsMobileMenu);
</script>
